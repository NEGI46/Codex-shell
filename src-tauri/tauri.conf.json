{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Shell",
  "version": "0.1.0",
  "identifier": "com.neg46.codex-shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Shell",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
